{
  "name": "pw-automation-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic-first Playwright and TypeScript framework for Automation Exercise Website",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:all": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:framework": "node --import tsx --test \"tests/framework/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node --import tsx tests/framework/architecture/check-architecture.ts",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run check:architecture && npm run test:framework",
    "agents:init": "node scripts/init-agents.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "zod": "4.6.7"
  }
}
